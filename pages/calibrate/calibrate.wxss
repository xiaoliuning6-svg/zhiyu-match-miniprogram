.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.intro {
  margin-bottom: 24rpx;
}

.intro .muted {
  margin-top: 12rpx;
  line-height: 1.65;
}

.dim + .dim {
  margin-top: 34rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f7f1ed;
}

.val {
  min-width: 72rpx;
  padding: 4rpx 0;
  border-radius: 12rpx;
  background: #fff2f0;
  color: #d2665c;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.dim slider {
  margin: 18rpx 0 6rpx;
}

.scale {
  margin-top: -4rpx;
}

/* 硬性条件行 */
.prow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f7f1ed;
}

.prow.last {
  border-bottom: none;
}

.plabel {
  font-size: 28rpx;
  color: #4a423c;
}

.pval {
  font-size: 28rpx;
  font-weight: 700;
  color: #d2665c;
}

.page-input {
  width: 160rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #faf7f5;
  font-size: 28rpx;
  text-align: center;
}

/* 画像完整度 */
.qhint {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #fff7ee;
  border: 2rpx solid #f6e7d7;
}

.qhint-t {
  flex: 0 0 auto;
  margin-right: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #b3704a;
}

.qhint-d {
  font-size: 22rpx;
  line-height: 1.6;
  color: #9a5a2e;
}

.foot {
  background: #faf7f5;
  border-top: 2rpx solid #f4ece8;
}
