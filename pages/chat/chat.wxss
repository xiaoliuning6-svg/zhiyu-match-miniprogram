.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 锁定横幅 */
.lock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #eef1fb;
}

.lock-t {
  font-size: 22rpx;
  color: #5b67a8;
  font-weight: 600;
}

.lock-end {
  font-size: 22rpx;
  color: #8a93c4;
  padding: 4rpx 10rpx;
}

/* 聊天区 */
.chat {
  flex: 1;
  min-height: 0;
  padding: 16rpx 32rpx 0;
  box-sizing: border-box;
}

.tip {
  margin-bottom: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: #f6f1ee;
  font-size: 21rpx;
  color: #a89f98;
  line-height: 1.6;
}

.msg {
  display: flex;
  flex-direction: column;
}

.chat-tail {
  height: 36rpx;
}

/* 军师面板 */
.mentor {
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-top: 2rpx solid #f2ebe7;
  max-height: 46vh;
  overflow: hidden;
}

.mt {
  font-size: 26rpx;
  font-weight: 800;
}

.mclose {
  font-size: 22rpx;
  color: #a89f98;
}

.mtext {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #faf7f5;
  font-size: 24rpx;
  line-height: 1.75;
  color: #4a423c;
  white-space: pre-wrap;
}

.minput {
  width: 100%;
  min-height: 80rpx;
  max-height: 180rpx;
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #faf7f5;
  font-size: 25rpx;
  line-height: 1.6;
}

.mrow {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.btn-sm.solid {
  background: #e8746b;
  color: #ffffff;
}

/* 工具条 */
.toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 28rpx;
  background: #ffffff;
}

.tool {
  font-size: 22rpx;
  color: #b3704a;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff7ee;
}

/* 输入 */
.inputbar .grow {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #faf7f5;
  font-size: 29rpx;
}

.ph {
  color: #b9b0a9;
}
