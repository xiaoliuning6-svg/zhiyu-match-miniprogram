<view class="page">
  <scroll-view class="scroll" scroll-y>
    <view class="body">
      <view class="head-card fade-up">
        <view class="row-between">
          <view class="h1">你的画像</view>
          <view class="charc">{{charCount}} 字</view>
        </view>
        <view class="muted" style="margin-top:8rpx">{{hardText}}</view>
      </view>

      <view class="card fade-up d1">
        <view class="dim" wx:for="{{dims}}" wx:key="name">
          <view class="row-between">
            <view class="dname">{{item.name}}</view>
            <view class="dval">{{item.value}}</view>
          </view>
          <view class="bar">
            <view class="bar-fill" style="width:{{item.w}}%"></view>
            <view class="bar-mid"></view>
          </view>
          <view class="row-between">
            <view class="tiny">{{item.left}}</view>
            <view class="tiny">{{item.right}}</view>
          </view>
        </view>
      </view>

      <view class="card fade-up d2">
        <view class="ptext">
          <view wx:for="{{blocks}}" wx:key="t" class="{{item.h ? 'pline-h' : 'pline'}}">{{item.t}}</view>
        </view>
      </view>

      <view class="formula fade-up d3">
        <view class="ft">匹配怎么算的</view>
        <view class="fd">五维做中心化后求相关系数 r，再映射 sim = (r + 1) / 2，只有 sim ≥ 0.70（等价 r ≥ 0.40）才进入推送列表。</view>
      </view>

      <view style="height:24rpx"></view>
    </view>
  </scroll-view>

  <view class="foot">
    <button class="btn" bindtap="goMatch" loading="{{matching}}">开始匹配</button>
    <view class="link" bindtap="edit">调整画像</view>
  </view>
</view>
