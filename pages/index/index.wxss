.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部账号条 ===== */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx 0;
}
.tb-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.tb-avatar {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #f0e6e0;
}
.tb-avatar.ph {
  background: linear-gradient(135deg, #f08b81 0%, #e8746b 100%);
  border: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
}
.tb-nick {
  font-size: 26rpx;
  color: #6f665f;
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tb-me {
  flex: 0 0 auto;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #fff2f0;
  color: #d2665c;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 顶部品牌区 ===== */
.hero {
  position: relative;
  padding: 28rpx 40rpx 44rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #fff3f1 0%, #fdf7f4 52%, #faf7f5 100%);
}

.hero-glow {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 116, 107, 0.22) 0%, rgba(232, 116, 107, 0) 70%);
}

.brand {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: #d2665c;
}

.slogan {
  margin-top: 20rpx;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.32;
  letter-spacing: -1rpx;
  color: #2b2622;
}

.hero-sub {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #8a8079;
}

/* ===== 三指标 ===== */
.metrics {
  display: flex;
  align-items: center;
  padding: 26rpx 8rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(120, 90, 80, 0.06);
}

.metric {
  flex: 1;
  text-align: center;
}

.mv {
  font-size: 34rpx;
  font-weight: 800;
  color: #e8746b;
}

.ml {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a89f98;
}

.metric-line {
  width: 2rpx;
  height: 46rpx;
  background: #f3ece8;
}

/* ===== 卖点列表 ===== */
.feat {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.feat + .feat {
  border-top: 2rpx solid #f7f1ed;
}

.ficon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: #fff2f0;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 继续/查看提示卡 ===== */
.resume {
  background: linear-gradient(135deg, #ffffff 0%, #fff8f6 100%);
  border: 2rpx solid #fbe4e0;
}

/* ===== 免责 ===== */
.disclaimer {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f6f1ee;
  font-size: 21rpx;
  line-height: 1.7;
  color: #a89f98;
}

.disclaimer .u {
  color: #d2665c;
  font-weight: 700;
}

/* ===== 底部按钮 ===== */
.foot {
  margin-top: auto;
  padding: 20rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
}

.restart {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a89f98;
}
