<view class="page">
  <view class="topbar">
    <view class="tb-user" bindtap="goMe">
      <image wx:if="{{avatar}}" class="tb-avatar" src="{{avatar}}" mode="aspectFill"></image>
      <view wx:else class="tb-avatar ph">{{nickFirst}}</view>
      <view class="tb-nick">{{nick}}</view>
    </view>
    <view class="tb-me" bindtap="goMe">我的</view>
  </view>

  <view class="hero">
    <view class="brand">知遇</view>
    <view class="slogan">
      <view>不是刷更多人，</view>
      <view>是找到对的那一个</view>
    </view>
    <view class="hero-sub">AI 红娘先和你深聊 5 个维度，再按「过日子方式」匹配</view>
    <view class="hero-glow"></view>
  </view>

  <view class="body">
    <view class="metrics fade-up">
      <view class="metric">
        <view class="mv">{{dimTotal}}</view>
        <view class="ml">深度维度</view>
      </view>
      <view class="metric-line"></view>
      <view class="metric">
        <view class="mv">≥70%</view>
        <view class="ml">相似度才推</view>
      </view>
      <view class="metric-line"></view>
      <view class="metric">
        <view class="mv">1v1</view>
        <view class="ml">强制专一</view>
      </view>
    </view>

    <view class="card fade-up d1">
      <view class="feat" wx:for="{{features}}" wx:key="t">
        <view class="ficon">{{item.i}}</view>
        <view class="grow">
          <view class="h3">{{item.t}}</view>
          <view class="muted">{{item.d}}</view>
        </view>
      </view>
    </view>

    <view class="card resume fade-up d2" wx:if="{{mode === 'doing'}}">
      <view class="row-between">
        <view class="grow">
          <view class="h3">上次聊到第 {{resumeDim}} 个维度</view>
          <view class="muted">接着聊完，画像才准</view>
        </view>
        <view class="btn-sm" bindtap="goResume">继续</view>
      </view>
    </view>

    <view class="card resume fade-up d2" wx:if="{{mode === 'done'}}">
      <view class="row-between">
        <view class="grow">
          <view class="h3">画像已生成</view>
          <view class="muted">去看看匹配到的人</view>
        </view>
        <view class="btn-sm" bindtap="goProfile">查看</view>
      </view>
    </view>

    <view class="disclaimer fade-up d3">
      本演示为个人学习用途：实名认证、人脸核身、婚况联网核实、资金托管<text class="u">均为模拟</text>，不收集真实隐私、不发起真实支付。用户池 {{poolSize}} 人全部虚构。
    </view>
  </view>

  <view class="foot">
    <button class="btn" bindtap="onMainTap">{{mainText}}</button>
    <view class="restart" bindtap="restart" wx:if="{{mode !== 'empty'}}">重新开始</view>
  </view>
</view>
