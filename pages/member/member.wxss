.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.hero {
  padding: 20rpx 0 32rpx;
  text-align: center;
}

.htag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #fff2f0;
  color: #d2665c;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.price {
  margin: 18rpx 0 6rpx;
  color: #e8746b;
}

.price .cur {
  font-size: 34rpx;
  font-weight: 700;
  vertical-align: 22rpx;
  margin-right: 4rpx;
}

.price .num {
  font-size: 88rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

/* 权益节点 */
.node {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}

.ni {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #fff2f0;
  color: #d2665c;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nt {
  font-size: 27rpx;
  font-weight: 700;
}

.nd {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8a8079;
}

/* 条款 */
.rule {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4a423c;
}

.dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 16rpx 0 4rpx;
  border-radius: 50%;
  background: #e8746b;
}

/* 已开通 */
.paidcard {
  background: linear-gradient(140deg, #fff6f4 0%, #ffffff 60%);
  border: 2rpx solid #fbe4e0;
}

.badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e8746b;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f9f1ed;
  font-size: 26rpx;
}

.k {
  color: #8a8079;
}

.v {
  font-weight: 700;
  color: #2b2622;
}

/* 警示 */
.warn {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f6f1ee;
  font-size: 21rpx;
  line-height: 1.7;
  color: #a89f98;
}

.reset {
  margin-top: 30rpx;
  text-align: center;
  font-size: 23rpx;
  color: #b9b0a9;
}

.foot {
  background: #faf7f5;
  border-top: 2rpx solid #f4ece8;
}
