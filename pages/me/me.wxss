/* ---------- 账号头部 ---------- */
.head-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  flex: 0 0 auto;
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: #faf7f5;
  border: 2rpx solid #f0e6e0;
}
.avatar.ph {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 124rpx;
  text-align: center;
  background: linear-gradient(135deg, #f08b81 0%, #e8746b 100%);
  border: none;
}
.head-main {
  flex: 1;
  min-width: 0;
}
.nick {
  font-size: 36rpx;
  font-weight: 800;
  color: #2b2622;
}
.meta {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #8a8079;
}
.uid {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #b8aea7;
}

.comp {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f6efeb;
}
.comp-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.comp-t {
  font-size: 25rpx;
  color: #8a8079;
}
.comp-v {
  font-size: 25rpx;
  font-weight: 700;
  color: #e8746b;
}
.comp-miss {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a89f98;
}

/* ---------- 区块头 ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sec-t {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2622;
}
.sec-r {
  font-size: 23rpx;
  color: #a89f98;
}

/* ---------- 照片九宫格 ---------- */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}
.photo-item {
  position: relative;
  width: 186rpx;
  height: 186rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #faf7f5;
}
.photo {
  width: 100%;
  height: 100%;
}
.del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: rgba(43, 38, 34, 0.6);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}
.photo-add {
  width: 186rpx;
  height: 186rpx;
  border-radius: 18rpx;
  background: #faf7f5;
  border: 2rpx dashed #ded4cd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #b8aea7;
}
.photo-add .plus {
  font-size: 46rpx;
  line-height: 1;
}
.photo-add .add-t {
  margin-top: 8rpx;
  font-size: 22rpx;
}

/* ---------- 设置行 ---------- */
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-top: 2rpx solid #f6efeb;
}
.line:first-of-type {
  margin-top: 8rpx;
}
.line-l {
  font-size: 29rpx;
  color: #2b2622;
}
.line-l.danger {
  color: #e0503f;
  font-weight: 600;
}
.line-r {
  font-size: 24rpx;
  color: #a89f98;
}

/* ---------- 子列表 ---------- */
.sub-list {
  padding: 4rpx 0 20rpx;
}
.empty-line {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #b8aea7;
  text-align: center;
}
.sub-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 18rpx;
  background: #faf7f5;
}
.sub-item.col {
  display: block;
}
.sub-avatar {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f0e6e0;
  color: #8a8079;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}
.sub-main {
  flex: 1;
  min-width: 0;
}
.sub-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #2b2622;
}
.sub-desc {
  font-size: 22rpx;
  color: #8a8079;
}
.rep-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rep-date {
  font-size: 21rpx;
  color: #b8aea7;
}
.rep-note {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 22rpx;
  color: #6f665f;
  line-height: 1.6;
}

/* ---------- 提示与边界 ---------- */
.hint {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fffaf5;
  font-size: 21rpx;
  color: #9a7b5e;
  line-height: 1.65;
}

.boundary {
  margin: 28rpx 0 8rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 238, 0.9);
  border: 2rpx solid #f4e6d5;
}
.bd-t {
  font-size: 24rpx;
  font-weight: 700;
  color: #9a5a2e;
  margin-bottom: 10rpx;
}
.bd-line {
  font-size: 21rpx;
  color: #9a5a2e;
  line-height: 1.8;
}
