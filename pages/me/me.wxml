<view class="page">
  <view class="body">

    <!-- 账号头部 -->
    <view class="card head">
      <view class="head-row">
        <image wx:if="{{account.avatar}}" class="avatar" src="{{account.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar ph">{{nickFirst}}</view>
        <view class="head-main">
          <view class="nick">{{account.nick || '未设置昵称'}}</view>
          <view class="meta">{{metaText}}</view>
          <view class="uid">本机账号 {{uidShort}}</view>
        </view>
        <view class="btn-sm" bindtap="editProfile">编辑</view>
      </view>

      <view class="comp">
        <view class="comp-top">
          <text class="comp-t">资料完整度</text>
          <text class="comp-v">{{comp.pct}}%</text>
        </view>
        <view class="progress"><view style="width:{{comp.pct}}%"></view></view>
        <view wx:if="{{comp.missing.length}}" class="comp-miss">还缺：{{missingText}}</view>
      </view>
    </view>

    <!-- 照片 -->
    <view class="card">
      <view class="sec-head">
        <view class="sec-t">我的照片</view>
        <view class="sec-r">{{photoCount}} / {{maxPhotos}}</view>
      </view>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="id">
          <image class="photo" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="preview"></image>
          <view class="del" data-id="{{item.id}}" catchtap="delPhoto">×</view>
        </view>
        <view class="photo-add" wx:if="{{canAdd}}" bindtap="addPhoto">
          <view class="plus">＋</view>
          <view class="add-t">添加</view>
        </view>
      </view>
      <view class="hint">照片只存在这台手机上，不会上传。换设备或清缓存就没了。</view>
    </view>

    <!-- 账号与安全 -->
    <view class="card">
      <view class="sec-t">账号与安全</view>

      <view class="line" bindtap="goMember">
        <view class="line-l">保结婚会员</view>
        <view class="line-r">查看 ›</view>
      </view>

      <view class="line" bindtap="logout">
        <view class="line-l">退出登录</view>
        <view class="line-r">数据保留 ›</view>
      </view>

      <view class="line" bindtap="deleteAccount">
        <view class="line-l danger">注销账号</view>
        <view class="line-r">不可恢复 ›</view>
      </view>

      <view class="hint">当前是本机账号：没有手机验证码、没有实名、没有人脸核身，也没有云端会话。真实产品这三项缺一不可。</view>
    </view>

    <!-- 隐私与治理 -->
    <view class="card">
      <view class="sec-t">隐私与治理</view>

      <view class="line" bindtap="toggleBlocked">
        <view class="line-l">已拉黑</view>
        <view class="line-r">{{blocked.length}} 人 {{showBlocked ? '收起' : '展开'}}</view>
      </view>
      <view wx:if="{{showBlocked}}" class="sub-list">
        <view wx:if="{{!blocked.length}}" class="empty-line">还没有拉黑任何人</view>
        <view class="sub-item" wx:for="{{blocked}}" wx:key="id">
          <view class="sub-avatar">{{item.initial}}</view>
          <view class="sub-main">
            <view class="sub-name">{{item.name}}</view>
            <view class="sub-desc">{{item.city}} · {{item.age}} 岁</view>
          </view>
          <view class="btn-sm" data-id="{{item.id}}" bindtap="unblock">解除</view>
        </view>
      </view>

      <view class="line" bindtap="toggleReports">
        <view class="line-l">我的举报</view>
        <view class="line-r">{{reports.length}} 条 {{showReports ? '收起' : '展开'}}</view>
      </view>
      <view wx:if="{{showReports}}" class="sub-list">
        <view wx:if="{{!reports.length}}" class="empty-line">还没有举报记录</view>
        <view class="sub-item col" wx:for="{{reports}}" wx:key="id">
          <view class="rep-top">
            <view class="sub-name">{{item.targetName}}</view>
            <view class="rep-date">{{item.date}}</view>
          </view>
          <view class="sub-desc">{{item.reasonLabel}}</view>
          <view wx:if="{{item.note}}" class="rep-note">{{item.note}}</view>
        </view>
      </view>

      <view class="hint">举报记录只写在本机，没有人工受理队列、没有处理回执。真实产品必须接审核后台。</view>
    </view>

    <!-- 边界 -->
    <view class="boundary">
      <view class="bd-t">演示版边界</view>
      <view class="bd-line">· 数据只在本机，无后端、无跨设备同步</view>
      <view class="bd-line">· 实名认证 / 人脸核身 / 婚况联网核实：未实现</view>
      <view class="bd-line">· 资金托管与 ¥2000 支付：未接入</view>
      <view class="bd-line">· 候选人池 24 人全部虚构</view>
    </view>

  </view>

  <view class="foot">
    <view class="btn-ghost" bindtap="goHome">回到首页</view>
  </view>
</view>
